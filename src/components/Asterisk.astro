---
interface Props { size: number; bar: number; color: string; class?: string }
const { size, bar, color, class: cls = '' } = Astro.props;
const base = `position:absolute;left:50%;top:0;width:${bar}px;height:100%;margin-left:-${bar / 2}px;background:${color}`;
---
<div aria-hidden="true" class:list={['relative shrink-0 anim-spin-slow', cls]} style={`width:${size}px;height:${size}px`}>
  <span style={base}></span>
  <span style={`${base};transform:rotate(60deg)`}></span>
  <span style={`${base};transform:rotate(-60deg)`}></span>
</div>
