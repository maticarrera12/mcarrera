---
import type { Copy } from '../i18n';
import Asterisk from './Asterisk.astro';
import { site, whatsappLink } from '../data/site';

interface Props { t: Copy }
const { t } = Astro.props;
const links = [
  { name: 'Email', value: site.email, href: `mailto:${site.email}`, arrow: '↗' },
  { name: 'LinkedIn', value: site.linkedin.label, href: site.linkedin.url, arrow: '↗', ext: true },
  { name: 'GitHub', value: site.github.label, href: site.github.url, arrow: '↗', ext: true },
  { name: 'Instagram', value: site.instagram.label, href: site.instagram.url, arrow: '↗', ext: true },
  { name: 'CV — PDF', value: t.cvLabel, href: site.cv, arrow: '↓', download: true },
];
const card = 'flex-[1_1_340px] min-w-0 bg-ink text-paper p-[clamp(28px,3vw,44px)] flex flex-col gap-5';
const cardTag = 'mono-label text-[11px] text-acid';
const cardTitle = 'display text-[clamp(36px,3.6vw,56px)] leading-[.92] m-0';
const cardBody = 'm-0 text-[17px] leading-normal text-soft max-w-[42ch] text-pretty';
---
<section id="contact" class="bg-cobalt text-paper px-[clamp(20px,4vw,56px)] pt-[clamp(80px,10vw,150px)] pb-[clamp(40px,5vw,64px)] relative overflow-hidden">
  <div aria-hidden="true" data-speed="0.08" class="spray absolute -right-[4%] top-[6%] w-[44%] h-[40%] bg-acid pointer-events-none [mask-image:radial-gradient(circle_at_70%_40%,#000_0,transparent_62%)]"></div>
  <div class="mono-label relative">(08) — {t.ctKicker}</div>
  <h2 data-reveal="0" class="display text-[clamp(64px,11.5vw,210px)] leading-[.86] mt-[18px] mb-[clamp(48px,6vw,88px)] relative">Have an idea?<br /><span class="text-acid">Let's build it.</span></h2>
  <div class="flex flex-wrap gap-4 relative">
    <div data-reveal="0" class={card}>
      <span class={cardTag}>A — {t.clientLabel}</span>
      <h3 class={cardTitle}>Have a project<br />in mind?</h3>
      <p class={cardBody}>{t.clientBody}</p>
      <a href={whatsappLink(t.waMessage)} target="_blank" rel="noopener noreferrer" data-magnetic class="mono-label self-start mt-2 flex gap-3 items-center px-6 py-[18px] bg-acid text-ink text-[13px] font-medium press hover:bg-paper">{t.clientCta} ↗</a>
    </div>
    <div data-reveal="100" class={card}>
      <span class={cardTag}>B — {t.teamLabel}</span>
      <h3 class={cardTitle}>Looking for<br />a developer?</h3>
      <p class={cardBody}>{t.teamBody}</p>
      <a href={`mailto:${site.email}?subject=${encodeURIComponent(t.mailSubject)}`} class="mono-label press self-start mt-2 flex gap-3 items-center px-6 py-[18px] border border-paper text-[13px] font-medium press hover:bg-paper hover:text-ink">{t.teamCta} ↗</a>
    </div>
    <div aria-hidden="true" class="flex-[0_1_260px] min-w-[220px] min-h-[300px] relative">
      <div class="absolute left-0 bottom-0 w-[64%] aspect-square bg-ink rounded-tl-full"></div>
      <div data-speed="-0.06" class="absolute right-[4%] top-[6%] w-[42%] aspect-square rounded-full bg-acid"></div>
      <div data-speed="0.05" class="absolute right-[8%] bottom-[8%]"><Asterisk size={72} bar={15} color="#f3f1eb" /></div>
    </div>
  </div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] mt-[clamp(48px,6vw,80px)] border-t border-paper/40 relative">
    {links.map((l) => (
      <a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener noreferrer' : undefined} download={l.download ? '' : undefined} class="mono-label flex justify-between gap-3 py-5 pr-4 border-b border-paper/40 text-[13px] nudge transition-colors duration-200 hover:text-acid">
        <span class="flex flex-col gap-1.5"><span>{l.name}</span><span class="normal-case break-all">{l.value}</span></span><span>{l.arrow}</span>
      </a>
    ))}
  </div>
</section>
